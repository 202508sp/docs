{
  "name": "docs",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "bunx textlint -c .textlintrc.handbook README.md handbook/**/*.md",
    "lint:fix": "bunx textlint -c .textlintrc.handbook --fix README.md handbook/**/*.md",
    "lint:typst": "bunx textlint -c .textlintrc ./docs/specification/*.typ",
    "lint:typst:fix": "bunx textlint -c .textlintrc --fix ./docs/specification/*.typ"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "textlint": "^14.4.2",
    "textlint-plugin-markdown": "^4.0.6",
    "textlint-plugin-typst": "^1.1.2",
    "textlint-rule-period-in-list-item": "^1.0.1",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  },
  "dependencies": {
    "textlint-filter-rule-comments": "^1.2.2",
    "textlint-rule-preset-jtf-style": "^3.0.2"
  }
}